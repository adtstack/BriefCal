// Local/CI build input. Never commit the real .env file.
BRIEFCAL_GOOGLE_TASKS_CLIENT_SECRET =
// xcconfig treats // as a comment, so use $() between the URL slashes.
BRIEFCAL_UPDATE_FEED_URL = https:/$()/updates.example.com/briefcal/appcast.xml
// Public Ed25519 key printed by Sparkle's generate_keys tool.
BRIEFCAL_SPARKLE_PUBLIC_ED_KEY =
